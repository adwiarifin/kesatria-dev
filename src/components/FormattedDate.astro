---
interface Props {
	date: Date;
}

const { date } = Astro.props;
---

<time datetime={date.toISOString()}>
	{
		date.toLocaleDateString('en-us', {
			year: 'numeric',
			month: 'short',
			day: 'numeric',
			// Builds run in UTC; pin to WIB so early-morning posts don't show the previous day.
			timeZone: 'Asia/Jakarta',
		})
	}
</time>
