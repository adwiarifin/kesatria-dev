---
import type { ImageMetadata } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SEO from '../components/SEO.astro';
import {
	AUTHOR_JOB_TITLE,
	AUTHOR_NAME,
	AUTHOR_PROFILES,
	SITE_URL,
} from '../consts';

interface Props {
	title?: string;
	description?: string;
	image?: ImageMetadata | string;
	type?: 'website' | 'article';
	canonical?: string | URL;
	publishedTime?: Date;
	modifiedTime?: Date;
}

const { title, description, image, type, canonical, publishedTime, modifiedTime } =
	Astro.props;

// Site-wide entities. The `@id` values let per-page schema (BlogPosting and
// friends) reference these nodes instead of redeclaring them.
const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'WebSite',
			'@id': `${SITE_URL}/#website`,
			name: 'Kesatria.dev',
			url: SITE_URL,
			publisher: { '@id': `${SITE_URL}/#person` },
		},
		{
			'@type': 'Person',
			'@id': `${SITE_URL}/#person`,
			name: AUTHOR_NAME,
			jobTitle: AUTHOR_JOB_TITLE,
			url: SITE_URL,
			sameAs: AUTHOR_PROFILES,
		},
	],
};

// `</script>` inside a JSON string would close the tag early, so escape `<`.
const structuredDataJSON = JSON.stringify(structuredData).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead />
		<SEO
			title={title}
			description={description}
			image={image}
			type={type}
			canonical={canonical}
			publishedTime={publishedTime}
			modifiedTime={modifiedTime}
		/>
		<script type="application/ld+json" set:html={structuredDataJSON} is:inline />
		<slot name="head" />
	</head>
	<body>
		<Header />
		<slot />
		<Footer />
	</body>
</html>
